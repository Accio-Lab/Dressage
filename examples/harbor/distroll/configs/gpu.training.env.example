# Synchronous GRPO: two actor nodes, one inference node, 128 executions.
# Direct access only. Public IPs are pending; set both before launching.
export GPU_HEAD_PUBLIC_IP="${GPU_HEAD_PUBLIC_IP:-}"
export CPU_HEAD_PUBLIC_IP="${CPU_HEAD_PUBLIC_IP:-}"
: "${GPU_HEAD_PUBLIC_IP:?GPU Head 公网IP待确定，请先设置 GPU_HEAD_PUBLIC_IP}"
: "${CPU_HEAD_PUBLIC_IP:?CPU Head 公网IP待确定，请先设置 CPU_HEAD_PUBLIC_IP}"
export GPU_NODE_IP="${GPU_NODE_IP:-}"  # 待确定；GPU Head内网示例10.10.0.10
export DRESSAGE_ACTOR_NODE_IPS="${DRESSAGE_ACTOR_NODE_IPS:-}"  # 待确定；示例10.10.0.10,10.10.0.11
export DRESSAGE_ROLLOUT_NODE_IP="${DRESSAGE_ROLLOUT_NODE_IP:-}"  # 待确定；示例10.10.0.12
: "${GPU_NODE_IP:?GPU Head 内网IP待确定，请先设置 GPU_NODE_IP}"
: "${DRESSAGE_ACTOR_NODE_IPS:?训练节点内网IP待确定，请先设置 DRESSAGE_ACTOR_NODE_IPS}"
: "${DRESSAGE_ROLLOUT_NODE_IP:?推理节点内网IP待确定，请先设置 DRESSAGE_ROLLOUT_NODE_IP}"
export ROLLOUT_CONTROL_URL="http://${CPU_HEAD_PUBLIC_IP}:19443"
export POLICY_SERVICE_URL="http://${GPU_NODE_IP}:18443"
export POLICY_SERVICE_HOST="${GPU_NODE_IP}"
export POLICY_SERVICE_PORT=18443
export POLICY_INTERNAL_HOST=127.0.0.1
export POLICY_INTERNAL_PORT=18081
export POLICY_MAX_MODEL_REQUEST_BYTES=33554432
export POLICY_MAX_MODEL_RESPONSE_BYTES=8388608
export POLICY_LEDGER_MAX_BYTES=4294967296
export POLICY_LEDGER_MAX_ENTRIES=8192
export POLICY_LEDGER_MAX_ENTRIES_PER_ROUTE=256
export POLICY_MAX_ACTIONS_PER_ROUTE=512
export POLICY_CLOSED_ROUTE_TTL_SEC=3600
export POLICY_MAX_CLOSED_ROUTES=4096
export POLICY_PROXY_RETRY_ATTEMPTS=4
export POLICY_PROXY_RETRY_BASE_SEC=0.25
export POLICY_PROXY_RETRY_MAX_SEC=2
export POLICY_PROXY_DISCARD_TIMEOUT_SEC=60
export POLICY_ROUTE_CLEANUP_TIMEOUT_SEC=150
export DRESSAGE_PROXY_URL=http://127.0.0.1:8800
export DRESSAGE_TRANSFER_QUEUE_CONFIG="${DRESSAGE_ROOT:?}/examples/scripts/default/dressage_transfer_queue.yaml"
export DRESSAGE_TRANSFER_PARAMS=logprobs
export DRESSAGE_TRANSFER_QUEUE_RETENTION_SECONDS=86400
export DRESSAGE_DISTROLL_RUN_ID=
export ROLLOUT_MODEL_NAME=qwen3.5-9b
export ROLLOUT_CONTROL_OUTAGE_TIMEOUT_SEC=0
