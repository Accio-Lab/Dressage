ROLLOUT_INVENTORY=/etc/dressage-distroll/inventory.yaml
ROLLOUT_WORKER_ID=WORKER_ID_PLACEHOLDER
ROLLOUT_CONTROL_URL="" # CPU Head内网地址待确定；示例http://10.20.0.10:19443
ROLLOUT_WORKER_HOST="" # 本Worker内网IP待确定；示例10.20.0.10或10.20.0.11
ROLLOUT_WORKER_PORT=19090
ROLLOUT_WORKER_POLL_SEC=1
ROLLOUT_WORKER_RETRY_MAX_SEC=30
ROLLOUT_WORKER_CONTROL_TIMEOUT_SEC=15
ROLLOUT_POLICY_TRANSPORT_RETRY_ATTEMPTS=20
ROLLOUT_POLICY_TRANSPORT_RETRY_BASE_SEC=0.5
ROLLOUT_POLICY_TRANSPORT_RETRY_MAX_SEC=10
# Enforce per-sandbox stop-loss and retain resource-release evidence.
ROLLOUT_SANDBOX_GUARD_MODE=enforce
ROLLOUT_SANDBOX_GUARD_SAMPLE_SEC=2
ROLLOUT_SANDBOX_GUARD_WINDOW_SEC=10
ROLLOUT_SANDBOX_GUARD_OOM_KILLS=3
ROLLOUT_SANDBOX_GUARD_MEMORY_FULL_RATIO=0.2
ROLLOUT_SANDBOX_GUARD_TERM_SEC=3
ROLLOUT_SANDBOX_GUARD_CLEANUP_SEC=30
